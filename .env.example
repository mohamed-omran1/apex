# Supabase — public project. Copy to .env.local and fill in.
# The service-role key is never added here and never used on the public site.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; RLS is the real protection.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Resend — server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# From address for lead emails, e.g. "Apex Climate Solutions <bookings@apexclimatesolutions.com>".
RESEND_FROM=
# Where the owner alert goes. One address, no cc list.
LEAD_NOTIFY_EMAIL=
# Canonical site URL used in email links, e.g. https://apexclimatesolutions.com
SITE_URL=

# Cloudflare Turnstile — optional. Without a secret key, verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
